{%- if section.blocks.size > 0 -%}
  <div
    class="custom-announcement-bar swiper"
    style="
      --custom-announcement-background: {{ section.settings.background_color }};
      --custom-announcement-text: {{ section.settings.text_color }};
      --custom-announcement-height: {{ section.settings.bar_height }}px;
      --custom-announcement-radius: {{ section.settings.corner_radius }}px;
      --custom-announcement-text-size: {{ section.settings.text_size }}px;
      --custom-announcement-space-top: {{ section.settings.space_top }}px;
      --custom-announcement-space-bottom: {{ section.settings.space_bottom }}px;
      --custom-announcement-space-horizontal: {{ section.settings.space_horizontal }}px;
    "
    data-speed="{{ section.settings.change_slides_speed }}"
    role="region"
    aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
    aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
  >
    <div class="custom-announcement-bar__track swiper-wrapper" aria-live="polite" aria-atomic="true">
      {%- for block in section.blocks -%}
        <div
          class="custom-announcement-bar__slide swiper-slide"
          role="group"
          aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
          aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.text != blank -%}
            {%- if block.settings.link != blank -%}
              <a class="custom-announcement-bar__link" href="{{ block.settings.link }}">
            {%- endif -%}
            <p class="custom-announcement-bar__message">{{ block.settings.text | escape }}</p>
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom announcement bar",
  "max_blocks": 12,
  "class": "custom-announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Bar background",
      "default": "#891719"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#fffaf5"
    },
    {
      "type": "range",
      "id": "bar_height",
      "min": 44,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bar height",
      "default": 58
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 13
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Space above bar",
      "default": 14
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Space below bar",
      "default": 14
    },
    {
      "type": "range",
      "id": "space_horizontal",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Side spacing",
      "default": 14
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change announcement every",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Get Extra 10% OFF on your 1st order via Laxmipati Sarees App | Download from Google Play store or Apple store"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom announcement bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
