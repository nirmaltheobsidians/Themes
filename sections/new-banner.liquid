{% style %}
.td-new-banner-section-custom { position: relative; isolation: isolate; }
.td-new-banner-section-custom .td-new-hero-slider { height: 943px; overflow: hidden; }
.td-new-banner-section-custom .td-new-hero-slide { position: relative; overflow: hidden; }
.td-new-banner-section-custom .td-new-banner-image-wrapper {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.td-new-banner-section-custom .td-new-banner-image-wrapper img {
  width: 100%; height: 100%; object-fit: cover; transform: scale(1.3); transition: transform 2.7s ease;
}
.td-new-banner-section-custom .swiper-slide-active .td-new-banner-image-wrapper img { transform: scale(1); }
.td-new-banner-section-custom .td-new-banner-image-wrapper::before {
  position: absolute; z-index: 1; inset: 0; background: rgb(0 0 0 / 22%); content: '';
}
.td-new-banner-section-custom .td-new-banner-content-outer {
  position: absolute; z-index: 2; top: 50%; left: 50%; width: 100%; margin: 0 auto; transform: translate(-50%, -50%);
}
.td-new-banner-section-custom .td-new-banner-content-inner {
  width: 100%; max-width: 512px; transform: translateX(-32px) scale(1.05);
  transition: all 1s linear, opacity 1.3s ease, transform 2.7s ease; opacity: 0;
}
.td-new-banner-section-custom .swiper-slide.td-slide-active .td-new-banner-content-inner {
  transform: translateX(0) scale(1); opacity: 1;
}
.td-new-banner-section-custom .td-new-banner-top {
  position: relative; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 10px;
  padding-bottom: 10px; color: #fff; font-size: 16px; font-weight: 400; line-height: 100%; text-transform: uppercase;
}
.td-new-banner-section-custom .td-new-banner-top::before {
  position: absolute; bottom: 0; left: 0; width: 0; height: 1px; background: #fff; content: '';
  transition: width 1s linear 1s;
}
.td-new-banner-section-custom .swiper-slide-active .td-new-banner-top::before { width: 60%; }
.td-new-banner-section-custom h1 {
  margin: 0 0 16px; color: #fff; font-size: 84px; font-weight: 400; line-height: 120%;
}
.td-new-banner-section-custom .td-new-banner-content-inner p {
  padding-right: 70px; color: #fff; font-size: 18px; line-height: 160%;
}
.td-new-banner-section-custom .td-new-banner-button-wrapper { margin-top: 32px; }
.td-new-banner-section-custom .td-new-theme-btn {
  display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: 14px 24px;
  overflow: hidden; border: 1px solid #fff; border-radius: 100px; color: #fff; background: transparent;
  text-decoration: none; transition: background-color .4s ease, color .4s ease, border-color .4s ease;
}
.td-new-banner-section-custom .td-new-btn-text {
  position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: center;
  color: inherit; font-size: 16px; font-weight: 500; line-height: normal; text-transform: capitalize;
}
.td-new-banner-section-custom .td-filled-btn { color: #111; background: #fff; }
.td-new-banner-section-custom .td-filled-btn:hover { border-color: #111; color: #fff; background: #111; }
.td-new-banner-section-custom .td-border-btn:hover { color: #111; background: #fff; }
.td-new-banner-section-custom .td-new-hero-slider-navigation {
  position: relative; z-index: 3; display: inline-flex; align-items: center; justify-content: flex-start; gap: 10px;
  transform: translateX(-32px) scale(1.05); transition: all 1s linear, opacity 1.3s ease, transform 2.7s ease; opacity: 0;
}
.td-new-banner-section-custom .td-slider-active .td-new-hero-slider-navigation {
  transform: translateX(0) scale(1); opacity: 1;
}
.td-new-banner-section-custom .td-slider-sliding .td-new-hero-slider-navigation {
  transform: translateX(0) scale(1); opacity: 0;
}
.td-new-banner-section-custom .td-new-hero-slider-nav {
  position: static; display: flex; width: 48px; height: 48px; align-items: center; justify-content: center;
  margin: 0; overflow: hidden; border: 1px solid #fff; border-radius: 50%; cursor: pointer;
}
.td-new-banner-section-custom .td-nav-icon-wrapper {
  display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; padding: 12px;
}
.td-new-banner-section-custom .td-new-hero-slider-progress {
  z-index: 1; width: 120px; height: 2px; overflow: hidden; background: rgb(255 255 255 / 16%);
}
.td-new-banner-section-custom .td-new-hero-slider-progress-fill {
  display: block; width: 0; height: 100%; background: #fff; transition: width .5s ease;
}
.td-new-banner-section-custom .td-new-banner-product-outer-box {
  position: absolute; z-index: 2; top: 0; right: 14px; overflow: visible;
}
.td-new-banner-section-custom .td-new-product-top-left-box { top: -50px; right: 100px; }
.td-new-banner-section-custom .td-new-product-center-box { top: 45px; right: 75px; }
.td-new-banner-section-custom .td-new-product-bottom-right-box { top: auto; right: 0; bottom: 0; }
.td-new-banner-section-custom .td-product-hightlight-box { position: relative; }
.td-new-banner-section-custom .td-product-highlight-dot {
  position: absolute; z-index: 2; top: -160px; display: flex; width: 22px; height: 22px; align-items: center;
  justify-content: center; border: 0; border-radius: 50%; background: #fff; cursor: pointer;
}
.td-new-banner-section-custom .td-product-highlight-outer-dot-border {
  position: absolute; width: 40px; height: 40px; border: 1px solid #fff; border-radius: 50%;
  animation: td-new-banner-pulse 2s infinite;
}
@keyframes td-new-banner-pulse {
  0% { transform: scale(.8); opacity: 1; }
  100% { transform: scale(1.2); opacity: 0; }
}
.td-new-banner-section-custom .td-new-banner-product-box {
  position: relative; z-index: 1; width: 100%; max-width: 365px; padding: 20px; border-radius: 10px;
  background: #fff; transform: translateY(40px); opacity: 0; transition: all .6s ease;
}
.td-new-banner-section-custom .td-product-hightlight-box.active .td-new-banner-product-box {
  z-index: 2; transform: translateY(0); opacity: 1;
}
.td-new-banner-section-custom .td-new-product-bottom-right-box .td-new-banner-product-box {
  transform: translateY(110px) translateX(-75px);
}
.td-new-banner-section-custom .td-new-product-bottom-right-box .td-product-hightlight-box.active .td-new-banner-product-box {
  transform: translateY(85px) translateX(-75px);
}
.td-new-banner-section-custom .td-new-product-center-box .td-new-banner-product-box {
  transform: translateX(-30px) translateY(45px);
}
.td-new-banner-section-custom .td-new-product-center-box .td-product-hightlight-box.active .td-new-banner-product-box {
  transform: translateX(-15px) translateY(45px);
}
.td-new-banner-section-custom .td-top-left-dot { top: -50px; }
.td-new-banner-section-custom .td-bottom-right-dot { top: auto; bottom: -150px; left: -15px; }
.td-new-banner-section-custom .td-center-dot { top: 38%; left: -75px; transform: translateY(-62%); }
.td-new-banner-section-custom .td-new-banner-product-box .card-wrapper { width: 100%; }
.td-new-banner-section-custom .td-new-product-swatch-box img {
  width: 100%; height: 100%; border-radius: 50%; object-fit: cover;
}
@media screen and (min-width: 767px) {
  .td-new-banner-section-custom .td-new-banner-button-wrapper {
    display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 16px;
  }
}
@media screen and (max-width: 767px) {
  .td-new-banner-section-custom .td-new-hero-slider { height: 700px; }
  .td-new-banner-section-custom .td-new-banner-button-wrapper { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .td-new-banner-section-custom .td-new-banner-content-inner h1 {
    font-size: 50px; font-weight: 500; line-height: normal; letter-spacing: 0; text-transform: capitalize;
  }
  .td-new-banner-section-custom .td-new-banner-content-inner p { padding-right: 0; }
  .td-new-banner-section-custom .td-new-product-center-box { display: none; }
  .td-new-banner-section-custom .td-new-product-top-left-box { top: -40px; right: 40px; }
  .td-new-banner-section-custom .td-new-product-bottom-right-box { top: -100px; right: -40px; bottom: auto; }
}
@media (prefers-reduced-motion: reduce) {
  .td-new-banner-section-custom *, .td-new-banner-section-custom *::before, .td-new-banner-section-custom *::after {
    animation-duration: .01ms !important; transition-duration: .01ms !important;
  }
}
{% endstyle %}

<div
  class="td-new-banner-section-custom"
  style="margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;"
>
  <div class="swiper td-new-hero-slider">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'slide' -%}
            <div class="swiper-slide td-new-hero-slide" {{ block.shopify_attributes }}>
              <div class="td-new-banner-image-wrapper">
                {%- if block.settings.banner_image != blank -%}
                  <img
                    src="{{ block.settings.banner_image | image_url: width: 2000 }}"
                    alt="{{ block.settings.banner_image.alt | escape }}"
                    width=""
                    height=""
                  >
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'td-new-banner-placeholder' }}
                {%- endif -%}
              </div>
              <div class="td-new-banner-content-outer page-width">
                <div class="td-new-banner-content-inner">
                  {%- if block.settings.top_text != blank -%}
                    <span class="td-new-banner-top">{{ block.settings.top_text }}</span>
                  {%- endif -%}

                  {%- if block.settings.heading != blank -%}
                    <h1>{{ block.settings.heading }}</h1>
                  {%- endif -%}

                  {%- if block.settings.description != blank -%}
                    <p>{{ block.settings.description }}</p>
                  {%- endif -%}

                  {%- if block.settings.show_buttons -%}
                    <div class="td-new-banner-button-wrapper">
                      {%- if block.settings.btn_1_label != blank -%}
                        <a href="{{ block.settings.btn_1_link }}" class="td-new-theme-btn td-filled-btn">
                          <span class="td-new-btn-text">
                            {{ block.settings.btn_1_label }}
                          </span>
                        </a>
                      {%- endif -%}

                      {%- if block.settings.btn_2_label != blank -%}
                        <a href="{{ block.settings.btn_2_link }}" class="td-new-theme-btn td-border-btn">
                          <span class="td-new-btn-text">
                            {{ block.settings.btn_2_label }}
                          </span>
                        </a>
                      {%- endif -%}
                      <div class="td-new-hero-slider-navigation">
                        <div class="swiper-button-prev td-new-hero-slider-nav">
                          <span class="td-nav-icon-wrapper">
                            <svg
                              width="20"
                              height="17"
                              viewBox="0 0 20 17"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="M8.25 0.75L0.75 8.25L8.25 15.75M0.75 8.25L18.75 8.25" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </span>
                        </div>
                        <div class="td-new-hero-slider-progress">
                          <div class="td-new-hero-slider-progress-fill"></div>
                        </div>
                        <div class="swiper-button-next td-new-hero-slider-nav">
                          <span class="td-nav-icon-wrapper">
                            <svg
                              width="20"
                              height="17"
                              viewBox="0 0 20 17"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="M11.25 0.75L18.75 8.25L11.25 15.75M18.75 8.25L0.75 8.25" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </span>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </div>

                <!-- Product Box 1: Top Left -->
                {%- if block.settings.show_product_1 -%}
                  <div class="td-new-banner-product-outer-box td-new-product-top-left-box">
                    <div class="td-product-hightlight-box">
                      <span class="td-product-highlight-dot td-top-left-dot">
                        <span class="td-product-highlight-outer-dot-border"></span>
                      </span>
                      {%- assign product_1 = block.settings.product_1 -%}

                      <div class="td-new-banner-product-box">
                        {% render 'card-product',
                          card_product: product_1,
                          media_aspect_ratio: 'adapt',
                          image_shape: false,
                          lazy_load: true,
                          show_secondary_image: true,
                          show_vendor: false,
                          show_rating: true,
                          skip_styles: false,
                          section_id: section.id,
                          quick_add: 'standard',
                          product_view_context: 'collection'
                        %}
                        {% comment %}
                          <div class="prd">
                            <div class="td-new-banner-product-box-inner">
                              {%- if product_1 != blank and product_1.media.size > 0 -%}
                                {%- for media in product_1.media limit: 3 -%}
                                  <div class="{%- if product_1.media.size > 3 -%} ctm_media {% else %} ctm_not_media {% endif %} {% if forloop.index == 2 %} media-2 {% endif %} td-new-banner-product-image-wrapper">
                                    <img
                                      src="{{ media | img_url:'master' }}"
                                      alt="{{ media.alt | escape }}"
                                      width="100%"
                                      height=""
                                    >
                                  </div>
                                {%- endfor -%}
                              {%- else -%}
                                <div class="td-new-banner-product-image-wrapper">
                                  <img src="{{ 'product-thumb-1.png' | asset_url }}" alt="banner_img" width="" height="">
                                </div>
                                <div class="td-new-banner-product-image-wrapper">
                                  <img src="{{ 'product-thumb-2.png' | asset_url }}" alt="banner_img" width="" height="">
                                </div>
                                <div class="td-new-banner-product-image-wrapper">
                                  <img src="{{ 'product-thumb-1.png' | asset_url }}" alt="banner_img" width="" height="">
                                </div>
                              {%- endif -%}
                            </div>

                            <div class="td-new-banner-product-price-wrapper">
                              <h5>
                                {{ product_1.title | default: block.settings.prod_1_title | default: 'Red Co-ord Set' }}
                              </h5>
                              <div class="td-new-banner-product-price">
                                <p class="td-product-price-text">
                                  {{ product_1.price | money | default: block.settings.prod_1_price | default: '$89' }}
                                </p>
                                <span class="td-prodcut-rating">
                                  {{ block.settings.prod_1_rating | default: '5.0' }}
                                  <svg
                                    width="13"
                                    height="13"
                                    viewBox="0 0 13 13"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                  >
                                    <path d="M12.1552 4.10812L8.52522 3.79312L7.10772 0.455625C6.85272 -0.151875 5.98272 -0.151875 5.72772 0.455625L4.31022 3.80063L0.687718 4.10812C0.0277181 4.16062 -0.242282 4.98562 0.260218 5.42062L3.01272 7.80562L2.18772 11.3456C2.03772 11.9906 2.73522 12.5006 3.30522 12.1556L6.41772 10.2806L9.53022 12.1631C10.1002 12.5081 10.7977 11.9981 10.6477 11.3531L9.82272 7.80562L12.5752 5.42062C13.0777 4.98562 12.8152 4.16062 12.1552 4.10812ZM6.41772 8.87812V1.90312L7.70022 4.93313L10.9852 5.21813L8.49522 7.37812L9.24522 10.5881L6.41772 8.87812Z" fill="#F0C05A" />
                                    <path d="M6.41772 8.87812V1.90312L7.70022 4.93313L10.9852 5.21813L8.49522 7.37812L9.24522 10.5881L6.41772 8.87812Z" fill="#F0C05A" />
                                  </svg>
                                </span>
                              </div>
                            </div>

                            <p class="td-new-banner-product-desc">
                              {%- if product_1 != blank -%}
                                {{ product_1.description | strip_html | truncate: 120 }}
                              {%- else -%}
                                {{
                                  block.settings.prod_1_desc
                                  | default: 'A refined blazer and trousers in stretch fabric — designed to move with you.'
                                }}
                              {%- endif -%}
                            </p>

                            <div class="td-new-banner-product-swatches-wrapper">
                              <div class="td-new-banner-product-color-swatch">
                                {%- if product_1 != blank and product_1.media.size > 0 -%}
                                  {%- for media in product_1.media limit: 4 -%}
                                    <a href="javascript:void(0);" class="td-new-product-swatch-box">
                                      <img
                                        src="{{ media | image_url: width: 100 }}"
                                        alt="{{ media.alt | escape }}"
                                        width=""
                                        height=""
                                      >
                                    </a>
                                  {%- endfor -%}
                                {%- else -%}
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                    ><img src="{{ 'product-thumb-1.png' | asset_url }}" alt="banner_img" width="" height=""
                                  ></a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                    ><img src="{{ 'color-swatch-2.png' | asset_url }}" alt="banner_img" width="" height=""
                                  ></a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                    ><img src="{{ 'color-swatch-3.png' | asset_url }}" alt="banner_img" width="" height=""
                                  ></a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                    ><img src="{{ 'color-swatch-4.png' | asset_url }}" alt="banner_img" width="" height=""
                                  ></a>
                                {%- endif -%}
                              </div>

                              <div class="td-new-banner-product-size-swatch">
                                {%- assign has_size_1 = false -%}
                                {%- if product_1 != blank -%}
                                  {%- for option in product_1.options_with_values -%}
                                    {%- if option.name == 'Size' or option.name == 'size' -%}
                                      {%- assign has_size_1 = true -%}
                                      {%- for value in option.values -%}
                                        <a href="javascript:void(0);" class="td-new-product-swatch-box">{{ value }}</a>
                                      {%- endfor -%}
                                    {%- endif -%}
                                  {%- endfor -%}
                                {%- endif -%}
                                {%- if has_size_1 == false -%}
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box">S</a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box">M</a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box">L</a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box">XL</a>
                                {%- endif -%}
                              </div>
                            </div>

                            <div class="td-new-add-to-cart-btn-wrapper">
                              <a
                                href="{{ product_1.url | default: 'javascript:void(0);' }}"
                                class="td-new-theme-btn td-new-theme-black-btn td-new-add-to-cart-btn"
                              >
                                <span class="td-new-btn-text">Add to cart</span>
                              </a>
                            </div>
                          </div>
                        {% endcomment %}
                      </div>
                    </div>
                  </div>
                {%- endif -%}

                <!-- Product Box 2: Center -->
                {%- if block.settings.show_product_2 -%}
                  <div class="td-new-banner-product-outer-box td-new-product-center-box">
                    <div class="td-product-hightlight-box">
                      <span class="td-product-highlight-dot td-center-dot">
                        <span class="td-product-highlight-outer-dot-border"></span>
                      </span>
                      {%- assign product_2 = block.settings.product_2 -%}

                      <div class="td-new-banner-product-box">
                        {% render 'card-product',
                          card_product: product_2,
                          media_aspect_ratio: 'adapt',
                          image_shape: false,
                          lazy_load: true,
                          show_secondary_image: true,
                          show_vendor: false,
                          show_rating: true,
                          skip_styles: false,
                          section_id: section.id,
                          quick_add: 'standard',
                          product_view_context: 'collection'
                        %}
                        {% comment %}
                          <div class="td-new-banner-product-box-inner">
                            {%- if product_2 != blank and product_2.media.size > 0 -%}
                              {%- for media in product_2.media limit: 3 -%}
                                <div class="{%- if product_2.media.size > 3 -%} ctm_media {% else %} ctm_not_media media-2 {% endif %} td-new-banner-product-image-wrapper">
                                  <img
                                    src="{{ media | img_url:'master' }}"
                                    alt="{{ media.alt | escape }}"
                                    width=""
                                    height=""
                                  >
                                </div>
                              {%- endfor -%}
                            {%- else -%}
                              <div class="td-new-banner-product-image-wrapper">
                                <img src="{{ 'product-thumb-1.png' | asset_url }}" alt="banner_img" width="" height="">
                              </div>
                              <div class="td-new-banner-product-image-wrapper">
                                <img src="{{ 'product-thumb-2.png' | asset_url }}" alt="banner_img" width="" height="">
                              </div>
                              <div class="td-new-banner-product-image-wrapper">
                                <img src="{{ 'product-thumb-1.png' | asset_url }}" alt="banner_img" width="" height="">
                              </div>
                            {%- endif -%}
                          </div>
                          <div class="td-new-banner-product-price-wrapper">
                            <h5>
                              {{ product_2.title | default: block.settings.prod_2_title | default: 'Red Co-ord Set' }}
                            </h5>
                            <div class="td-new-banner-product-price">
                              <p class="td-product-price-text">
                                {{ product_2.price | money | default: block.settings.prod_2_price | default: '$89' }}
                              </p>
                              <span class="td-prodcut-rating">
                                {{- block.settings.prod_2_rating | default: '5.0' }}
                                <svg
                                  width="13"
                                  height="13"
                                  viewBox="0 0 13 13"
                                  fill="none"
                                  xmlns="http://www.w3.org/2000/svg"
                                >
