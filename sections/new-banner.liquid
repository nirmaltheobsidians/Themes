                              {%- if product_3 != blank and product_3.media.size > 0 -%}
                                {%- for media in product_3.media limit: 4 -%}
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box">
                                    <img
                                      src="{{ media | image_url: width: 100 }}"
                                      alt="{{ media.alt | escape }}"
                                      width=""
                                      height=""
                                    >
                                  </a>
                                {%- endfor -%}
                              {%- else -%}
                                <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                  ><img src="{{ 'product-thumb-1.png' | asset_url }}" alt="banner_img" width="" height=""
                                ></a>
                                <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                  ><img src="{{ 'color-swatch-2.png' | asset_url }}" alt="banner_img" width="" height=""
                                ></a>
                                <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                  ><img src="{{ 'color-swatch-3.png' | asset_url }}" alt="banner_img" width="" height=""
                                ></a>
                                <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                  ><img src="{{ 'color-swatch-4.png' | asset_url }}" alt="banner_img" width="" height=""
                                ></a>
                              {%- endif -%}
                            </div>
                            <div class="td-new-banner-product-size-swatch">
                              {%- assign has_size_3 = false -%}
                              {%- if product_3 != blank -%}
                                {%- for option in product_3.options_with_values -%}
                                  {%- if option.name == 'Size' or option.name == 'size' -%}
                                    {%- assign has_size_3 = true -%}
                                    {%- for value in option.values -%}
                                      <a href="javascript:void(0);" class="td-new-product-swatch-box">{{ value }}</a>
                                    {%- endfor -%}
                                  {%- endif -%}
                                {%- endfor -%}
                              {%- endif -%}
                              {%- if has_size_3 == false -%}
                                <a href="javascript:void(0);" class="td-new-product-swatch-box">S</a>
                                <a href="javascript:void(0);" class="td-new-product-swatch-box">M</a>
                                <a href="javascript:void(0);" class="td-new-product-swatch-box">L</a>
                                <a href="javascript:void(0);" class="td-new-product-swatch-box">XL</a>
                              {%- endif -%}
                            </div>
                          </div>
                          <div class="td-new-add-to-cart-btn-wrapper">
                            <a
                              href="{{ product_3.url | default: 'javascript:void(0);' }}"
                              class="td-new-theme-btn td-new-theme-black-btn td-new-add-to-cart-btn"
                            >
                              <span class="td-new-btn-text">Add to cart</span>
                            </a>
                          </div>
                        {% endcomment %}
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    <div class="swiper-pagination"></div>
  </div>
</div>

<script>
  document.addEventListener(
    'click',
    function (event) {
      // Check karein ki click swatch box par hua hai ya uske andar ki image par
      const swatchBox = event.target.closest('.td-new-product-swatch-box');
      if (!swatchBox) return;

      // Swatch box ke andar ki image ka src nikalen
      const swatchImg = swatchBox.querySelector('img');
      if (!swatchImg) return;
      const newSrc = swatchImg.getAttribute('src');

      // Sahi parent product box ko target karein
      const productBox = swatchBox.closest('.td-new-banner-product-box');

      if (productBox) {
        const media2Img = productBox.querySelector('.media-2 img, .media-2');

        if (media2Img) {
          if (media2Img.tagName === 'IMG') {
            media2Img.setAttribute('src', newSrc);
          } else {
            const img = media2Img.querySelector('img');
            if (img) img.setAttribute('src', newSrc);
          }
          console.log('Theme mein image successfully update ho gayi:', newSrc);
        } else {
          console.log('.media-2 nahi mili is product box mein.');
        }
      } else {
        console.log('.td-new-banner-product-box nahi mila.');
      }
    },
    true
  ); // <--- Yeh 'true' bohot zaroori hai, yehi theme ke baki scripts ke interference ko bypass karega

  document.addEventListener('click', function (event) {
    const swatchBox = event.target.closest('.td-new-product-swatch-box');
    if (!swatchBox) return;

    const productBox = swatchBox.closest('.td-new-banner-product-box');
    if (!productBox) return;

    // Visual active class toggle karne ke liye
    swatchBox.parentElement
      .querySelectorAll('.td-new-product-swatch-box')
      .forEach((el) => el.classList.remove('is-active'));
    swatchBox.classList.add('is-active');

    // Yahan aap apne product ke available variants ka data map kar sakte hain
    // Ya agar aapke paas variant ID attribute hai toh use update karein:
    const variantId = swatchBox.getAttribute('data-variant-id');
    if (variantId) {
      const form = productBox.closest('form');
      if (form) {
        const variantInput = form.querySelector('.product-variant-id');
        if (variantInput) variantInput.value = variantId;
      }
    }
  });
</script>

