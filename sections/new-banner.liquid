  <script>
    (() => {
      const section = document.currentScript.closest('.td-new-banner-section-custom');
      const slider = section.querySelector('.td-new-hero-slider');
      const swiperCssUrl = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
      const swiperJsUrl = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';

      if (!document.querySelector('[data-td-hero-swiper-css], link[href*="swiper-bundle.min.css"]')) {
        const stylesheet = document.createElement('link');
        stylesheet.rel = 'stylesheet';
        stylesheet.href = swiperCssUrl;
        stylesheet.dataset.tdHeroSwiperCss = '';
        stylesheet.addEventListener('error', () => {
          console.error('Custom Hero Banner could not load the Swiper stylesheet.');
        });
        document.head.appendChild(stylesheet);
      }

      function loadSwiper() {
        if (window.Swiper) return Promise.resolve(window.Swiper);
        if (window.tdHeroSwiperLoader) return window.tdHeroSwiperLoader;

        window.tdHeroSwiperLoader = new Promise((resolve, reject) => {
          const existingScript = [...document.scripts].find((script) => script.src.includes('swiper-bundle.min.js'));
          const script = existingScript || document.createElement('script');
          const handleLoad = () => {
            if (window.Swiper) {
              resolve(window.Swiper);
            } else {
              reject(new Error('Swiper loaded without exposing its constructor.'));
            }
          };
          const handleError = () => reject(new Error('Custom Hero Banner could not load the Swiper script.'));

          script.addEventListener('load', handleLoad, { once: true });
          script.addEventListener('error', handleError, { once: true });

          if (!existingScript) {
            script.src = swiperJsUrl;
            document.head.appendChild(script);
          }
        });

        return window.tdHeroSwiperLoader;
      }

      function initializeHeroSlider() {
        if (!slider || slider.swiper) return;

        const totalSlides = slider.querySelectorAll('.swiper-slide:not(.swiper-slide-duplicate)').length;
        if (!totalSlides) return;

        const progressFill = slider.querySelector('.td-new-hero-slider-progress-fill');
        const swiper = new window.Swiper(slider, {
          speed: 1400,
          loop: true,
          effect: 'slide',
          navigation: {
            nextEl: slider.querySelector('.swiper-button-next'),
            prevEl: slider.querySelector('.swiper-button-prev'),
          },
        });

        function updateActiveClass() {
          swiper.slides.forEach((slide) => slide.classList.remove('td-slide-active'));
          const activeSlide = swiper.slides[swiper.activeIndex];
          if (activeSlide) activeSlide.classList.add('td-slide-active');
          slider.classList.add('td-slider-active');
        }

        function updateProgress() {
          if (!progressFill || !totalSlides) return;
          progressFill.style.width = `${((swiper.realIndex + 1) / totalSlides) * 100}%`;
        }

        updateActiveClass();
        updateProgress();

        swiper.on('slideChangeTransitionStart', () => {
          slider.classList.add('td-slider-sliding');
        });

        swiper.on('slideChangeTransitionEnd', () => {
          slider.classList.remove('td-slider-sliding');
          updateActiveClass();
          updateProgress();
        });
      }

      loadSwiper()
        .then(initializeHeroSlider)
        .catch((error) => console.error('Custom Hero Banner initialization failed.', error));

      section.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;

        const highlightDot = target.closest('.td-product-highlight-dot');
        if (highlightDot && section.contains(highlightDot)) {
          const currentBox = highlightDot.closest('.td-product-hightlight-box');
          if (!currentBox) return;

          section.querySelectorAll('.td-product-hightlight-box.active').forEach((box) => {
            if (box !== currentBox) box.classList.remove('active');
          });
          currentBox.classList.toggle('active');
          return;
        }

        const swatchBox = target.closest('.td-new-product-swatch-box');
        if (!swatchBox || !section.contains(swatchBox)) return;

        const productBox = swatchBox.closest('.td-new-banner-product-box');
        if (!productBox) return;

        swatchBox.parentElement
          .querySelectorAll('.td-new-product-swatch-box')
          .forEach((swatch) => swatch.classList.remove('is-active'));
        swatchBox.classList.add('is-active');

        const swatchImage = swatchBox.querySelector('img');
        const secondaryImage = productBox.querySelector('.media-2 img, .media-2');
        if (swatchImage && secondaryImage) {
          const targetImage = secondaryImage.tagName === 'IMG' ? secondaryImage : secondaryImage.querySelector('img');
          if (targetImage) targetImage.setAttribute('src', swatchImage.getAttribute('src'));
        }

        const variantId = swatchBox.getAttribute('data-variant-id');
        const variantInput = variantId ? productBox.closest('form')?.querySelector('.product-variant-id') : null;
        if (variantInput) variantInput.value = variantId;
      });
    })();
  </script>
