{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{{ 'mask-blobs.css' | asset_url | stylesheet_tag }}

{{ 'quick-add.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>

<div
  class="td-new-banner-section-custom"
  style="margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;"
>
  <div class="swiper td-new-hero-slider">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'slide' -%}
            <div class="swiper-slide td-new-hero-slide" {{ block.shopify_attributes }}>
              <div class="td-new-banner-image-wrapper">
                {%- if block.settings.banner_image != blank -%}
                  <img
                    src="{{ block.settings.banner_image | image_url: width: 2000 }}"
                    alt="{{ block.settings.banner_image.alt | escape }}"
                    width=""
                    height=""
                  >
                {%- else -%}
                  <img src="{{ 'new-theme-banner.jpg' | asset_url }}" alt="banner_img" width="" height="">
                {%- endif -%}
              </div>
              <div class="td-new-banner-content-outer page-width">
                <div class="td-new-banner-content-inner">
                  {%- if block.settings.top_text != blank -%}
                    <span class="td-new-banner-top">{{ block.settings.top_text }}</span>
                  {%- endif -%}

                  {%- if block.settings.heading != blank -%}
                    <h1>{{ block.settings.heading }}</h1>
                  {%- endif -%}

                  {%- if block.settings.description != blank -%}
                    <p>{{ block.settings.description }}</p>
                  {%- endif -%}

                  {%- if block.settings.show_buttons -%}
                    <div class="td-new-banner-button-wrapper">
                      {%- if block.settings.btn_1_label != blank -%}
                        <a href="{{ block.settings.btn_1_link }}" class="td-new-theme-btn td-filled-btn">
                          <span class="td-new-btn-text">
                            {{ block.settings.btn_1_label }}
                          </span>
                        </a>
                      {%- endif -%}

                      {%- if block.settings.btn_2_label != blank -%}
                        <a href="{{ block.settings.btn_2_link }}" class="td-new-theme-btn td-border-btn">
                          <span class="td-new-btn-text">
                            {{ block.settings.btn_2_label }}
                          </span>
                        </a>
                      {%- endif -%}
                      <div class="td-new-hero-slider-navigation">
                        <div class="swiper-button-prev td-new-hero-slider-nav">
                          <span class="td-nav-icon-wrapper">
                            <svg
                              width="20"
                              height="17"
                              viewBox="0 0 20 17"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="M8.25 0.75L0.75 8.25L8.25 15.75M0.75 8.25L18.75 8.25" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </span>
                        </div>
                        <div class="td-new-hero-slider-progress">
                          <div class="td-new-hero-slider-progress-fill"></div>
                        </div>
                        <div class="swiper-button-next td-new-hero-slider-nav">
                          <span class="td-nav-icon-wrapper">
                            <svg
                              width="20"
                              height="17"
                              viewBox="0 0 20 17"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="M11.25 0.75L18.75 8.25L11.25 15.75M18.75 8.25L0.75 8.25" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </span>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </div>

                <!-- Product Box 1: Top Left -->
                {%- if block.settings.show_product_1 -%}
                  <div class="td-new-banner-product-outer-box td-new-product-top-left-box">
                    <div class="td-product-hightlight-box">
                      <span class="td-product-highlight-dot td-top-left-dot">
                        <span class="td-product-highlight-outer-dot-border"></span>
                      </span>
                      {%- assign product_1 = block.settings.product_1 -%}

                      <div class="td-new-banner-product-box">
                        {% render 'card-product',
                          card_product: product_1,
                          media_aspect_ratio: 'adapt',
                          image_shape: false,
                          lazy_load: true,
                          show_secondary_image: true,
                          show_vendor: false,
                          show_rating: true,
                          skip_styles: false,
                          section_id: section.id,
                          quick_add: 'standard',
                          product_view_context: 'collection'
                        %}
                        {% comment %}
                          <div class="prd">
                            <div class="td-new-banner-product-box-inner">
                              {%- if product_1 != blank and product_1.media.size > 0 -%}
                                {%- for media in product_1.media limit: 3 -%}
                                  <div class="{%- if product_1.media.size > 3 -%} ctm_media {% else %} ctm_not_media {% endif %} {% if forloop.index == 2 %} media-2 {% endif %} td-new-banner-product-image-wrapper">
                                    <img
                                      src="{{ media | img_url:'master' }}"
                                      alt="{{ media.alt | escape }}"
                                      width="100%"
                                      height=""
                                    >
                                  </div>
                                {%- endfor -%}
                              {%- else -%}
                                <div class="td-new-banner-product-image-wrapper">
                                  <img src="{{ 'product-thumb-1.png' | asset_url }}" alt="banner_img" width="" height="">
                                </div>
                                <div class="td-new-banner-product-image-wrapper">
                                  <img src="{{ 'product-thumb-2.png' | asset_url }}" alt="banner_img" width="" height="">
                                </div>
                                <div class="td-new-banner-product-image-wrapper">
                                  <img src="{{ 'product-thumb-1.png' | asset_url }}" alt="banner_img" width="" height="">
                                </div>
                              {%- endif -%}
                            </div>

                            <div class="td-new-banner-product-price-wrapper">
                              <h5>
                                {{ product_1.title | default: block.settings.prod_1_title | default: 'Red Co-ord Set' }}
                              </h5>
                              <div class="td-new-banner-product-price">
                                <p class="td-product-price-text">
                                  {{ product_1.price | money | default: block.settings.prod_1_price | default: '$89' }}
                                </p>
                                <span class="td-prodcut-rating">
                                  {{ block.settings.prod_1_rating | default: '5.0' }}
                                  <svg
                                    width="13"
                                    height="13"
                                    viewBox="0 0 13 13"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                  >
                                    <path d="M12.1552 4.10812L8.52522 3.79312L7.10772 0.455625C6.85272 -0.151875 5.98272 -0.151875 5.72772 0.455625L4.31022 3.80063L0.687718 4.10812C0.0277181 4.16062 -0.242282 4.98562 0.260218 5.42062L3.01272 7.80562L2.18772 11.3456C2.03772 11.9906 2.73522 12.5006 3.30522 12.1556L6.41772 10.2806L9.53022 12.1631C10.1002 12.5081 10.7977 11.9981 10.6477 11.3531L9.82272 7.80562L12.5752 5.42062C13.0777 4.98562 12.8152 4.16062 12.1552 4.10812ZM6.41772 8.87812V1.90312L7.70022 4.93313L10.9852 5.21813L8.49522 7.37812L9.24522 10.5881L6.41772 8.87812Z" fill="#F0C05A" />
                                    <path d="M6.41772 8.87812V1.90312L7.70022 4.93313L10.9852 5.21813L8.49522 7.37812L9.24522 10.5881L6.41772 8.87812Z" fill="#F0C05A" />
                                  </svg>
                                </span>
                              </div>
                            </div>

                            <p class="td-new-banner-product-desc">
                              {%- if product_1 != blank -%}
                                {{ product_1.description | strip_html | truncate: 120 }}
                              {%- else -%}
                                {{
                                  block.settings.prod_1_desc
                                  | default: 'A refined blazer and trousers in stretch fabric — designed to move with you.'
                                }}
                              {%- endif -%}
                            </p>

                            <div class="td-new-banner-product-swatches-wrapper">
                              <div class="td-new-banner-product-color-swatch">
                                {%- if product_1 != blank and product_1.media.size > 0 -%}
                                  {%- for media in product_1.media limit: 4 -%}
                                    <a href="javascript:void(0);" class="td-new-product-swatch-box">
                                      <img
                                        src="{{ media | image_url: width: 100 }}"
                                        alt="{{ media.alt | escape }}"
                                        width=""
                                        height=""
                                      >
                                    </a>
                                  {%- endfor -%}
                                {%- else -%}
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                    ><img src="{{ 'product-thumb-1.png' | asset_url }}" alt="banner_img" width="" height=""
                                  ></a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                    ><img src="{{ 'color-swatch-2.png' | asset_url }}" alt="banner_img" width="" height=""
                                  ></a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                    ><img src="{{ 'color-swatch-3.png' | asset_url }}" alt="banner_img" width="" height=""
                                  ></a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box"
                                    ><img src="{{ 'color-swatch-4.png' | asset_url }}" alt="banner_img" width="" height=""
                                  ></a>
                                {%- endif -%}
                              </div>

                              <div class="td-new-banner-product-size-swatch">
                                {%- assign has_size_1 = false -%}
                                {%- if product_1 != blank -%}
                                  {%- for option in product_1.options_with_values -%}
                                    {%- if option.name == 'Size' or option.name == 'size' -%}
                                      {%- assign has_size_1 = true -%}
                                      {%- for value in option.values -%}
                                        <a href="javascript:void(0);" class="td-new-product-swatch-box">{{ value }}</a>
                                      {%- endfor -%}
                                    {%- endif -%}
                                  {%- endfor -%}
                                {%- endif -%}
                                {%- if has_size_1 == false -%}
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box">S</a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box">M</a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box">L</a>
                                  <a href="javascript:void(0);" class="td-new-product-swatch-box">XL</a>
                                {%- endif -%}
                              </div>
                            </div>

                            <div class="td-new-add-to-cart-btn-wrapper">
                              <a
                                href="{{ product_1.url | default: 'javascript:void(0);' }}"
                                class="td-new-theme-btn td-new-theme-black-btn td-new-add-to-cart-btn"
                              >
                                <span class="td-new-btn-text">Add to cart</span>
                              </a>
                            </div>
                          </div>
                        {% endcomment %}
                      </div>
                    </div>
                  </div>
                {%- endif -%}

