<section
  id="ShopByOccasion-{{ section.id }}"
  class="shop-by-occasion"
  style="
    --shop-by-occasion-background: {{ section.settings.background_color }};
    --shop-by-occasion-heading: {{ section.settings.heading_color }};
    --shop-by-occasion-label: {{ section.settings.label_color }};
    --shop-by-occasion-gap: {{ section.settings.card_gap }}px;
    --shop-by-occasion-offset: {{ section.settings.stagger_offset }}px;
    --shop-by-occasion-top: {{ section.settings.padding_top }}px;
    --shop-by-occasion-bottom: {{ section.settings.padding_bottom }}px;
    --shop-by-occasion-pattern-opacity: {{ section.settings.pattern_opacity | divided_by: 100.0 }};
  "
>
  <div class="shop-by-occasion__inner page-width">
    {%- if section.settings.heading != blank -%}
      <header class="shop-by-occasion__header">
        <img
          class="shop-by-occasion__divider"
          src="{{ 'category-divider.svg' | asset_url }}"
          width="90"
          height="23"
          alt=""
          aria-hidden="true"
          loading="lazy"
        >
        <h2 class="shop-by-occasion__heading">{{ section.settings.heading | escape }}</h2>
        <img
          class="shop-by-occasion__divider shop-by-occasion__divider--flipped"
          src="{{ 'category-divider.svg' | asset_url }}"
          width="90"
          height="23"
          alt=""
          aria-hidden="true"
          loading="lazy"
        >
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="shop-by-occasion__grid">
        {%- for column in (0..1) -%}
          <div class="shop-by-occasion__column{% if column == 1 %} shop-by-occasion__column--staggered{% endif %}">
            {%- for block in section.blocks -%}
              {%- assign block_column = forloop.index0 | modulo: 2 -%}
              {%- if block_column == column -%}
                {%- assign occasion_title = block.settings.title | default: 'Occasion' -%}
                {%- assign occasion_image_alt = block.settings.image.alt | default: occasion_title -%}
                {%- assign occasion_order = forloop.index0 -%}
                {%- assign occasion_offset_index = occasion_order | modulo: 2 -%}
                {%- assign occasion_desktop_offset = '0px' -%}
                {%- if occasion_offset_index == 1 -%}
                  {%- assign occasion_desktop_offset = 'var(--shop-by-occasion-offset)' -%}
                {%- endif -%}
                <div
                  class="shop-by-occasion__item"
                  style="
                    --shop-by-occasion-image-position: {{ block.settings.image_position }};
                    --shop-by-occasion-order: {{ occasion_order }};
                    --shop-by-occasion-desktop-offset: {{ occasion_desktop_offset }};
                  "
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.link != blank -%}
                    <a class="shop-by-occasion__card" href="{{ block.settings.link }}">
                  {%- else -%}
                    <div class="shop-by-occasion__card">
                  {%- endif -%}
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 1000
                        | image_tag:
                          class: 'shop-by-occasion__image',
                          widths: '240, 360, 540, 720, 1000',
                          sizes: '(min-width: 990px) 40vw, (min-width: 750px) 44vw, 46vw',
                          loading: 'lazy',
                          alt: occasion_image_alt
                      }}
                    {%- else -%}
                      {{ 'collection-apparel-1' | placeholder_svg_tag: 'shop-by-occasion__image shop-by-occasion__placeholder' }}
                    {%- endif -%}
                    <span class="shop-by-occasion__shade" aria-hidden="true"></span>
                    <span class="shop-by-occasion__label">{{ occasion_title | escape }}</span>
                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #ShopByOccasion-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: var(--shop-by-occasion-top);
    padding-bottom: var(--shop-by-occasion-bottom);
    background-color: var(--shop-by-occasion-background);
  }

  #ShopByOccasion-{{ section.id }}::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image:
      url('{{ 'category-mandala.svg' | asset_url }}'),
      url('{{ 'category-mandala.svg' | asset_url }}'),
      url('{{ 'category-mandala.svg' | asset_url }}'),
      url('{{ 'category-mandala.svg' | asset_url }}');
    background-repeat: no-repeat;
    background-position: left -76px top -88px, right -78px top 34px, left -84px bottom -86px, right -86px bottom -88px;
    background-size: 154px 154px, 196px 196px, 220px 220px, 178px 178px;
    content: '';
    opacity: var(--shop-by-occasion-pattern-opacity);
    pointer-events: none;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__inner {
    width: 100%;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto 24px;
    text-align: center;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__divider {
    display: block;
    width: 90px;
    height: 23px;
    object-fit: contain;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__divider--flipped {
    transform: rotate(180deg);
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__heading {
    margin: 4px 0;
    color: var(--shop-by-occasion-heading);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(20px, 2.2vw, 32px);
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--shop-by-occasion-gap);
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__column {
    display: grid;
    align-content: start;
    gap: var(--shop-by-occasion-gap);
    min-width: 0;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__column--staggered {
    padding-top: var(--shop-by-occasion-offset);
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__item {
    min-width: 0;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__card {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 0.74;
    color: var(--shop-by-occasion-label);
    text-decoration: none;
    background: #e8d9cb;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--shop-by-occasion-image-position, center center);
    transition: transform 350ms ease;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__placeholder {
    padding: 14%;
    opacity: 0.48;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__shade {
    position: absolute;
    inset: 55% 0 0;
    background: linear-gradient(180deg, transparent 0%, rgba(116, 22, 18, 0.34) 48%, rgba(116, 22, 18, 0.88) 100%);
    pointer-events: none;
  }

  #ShopByOccasion-{{ section.id }} .shop-by-occasion__label {
    position: absolute;
    right: 8px;
    bottom: 8%;
    left: 8px;
    color: var(--shop-by-occasion-label);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(18px, 2vw, 28px);
    font-weight: 400;
    line-height: 1.1;
    text-align: center;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.22);
  }

  @media screen and (min-width: 750px) {
    #ShopByOccasion-{{ section.id }} {
      padding-right: 0;
      padding-left: 0;
    }

    #ShopByOccasion-{{ section.id }} .shop-by-occasion__header {
      margin-bottom: 32px;
    }

    #ShopByOccasion-{{ section.id }} .shop-by-occasion__grid {
      gap: max(var(--shop-by-occasion-gap), 18px);
    }

    #ShopByOccasion-{{ section.id }} .shop-by-occasion__column {
      gap: max(var(--shop-by-occasion-gap), 12px);
    }

    #ShopByOccasion-{{ section.id }} .shop-by-occasion__card {
      aspect-ratio: 0.74;
    }
  }

  @media screen and (min-width: 990px) {
    #ShopByOccasion-{{ section.id }} .shop-by-occasion__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: start;
      gap: max(var(--shop-by-occasion-gap), 20px);
    }

    #ShopByOccasion-{{ section.id }} .shop-by-occasion__column {
      display: contents;
    }

    #ShopByOccasion-{{ section.id }} .shop-by-occasion__item {
      order: var(--shop-by-occasion-order);
      margin-top: var(--shop-by-occasion-desktop-offset);
    }
  }

  @media screen and (max-width: 749px) {
    #ShopByOccasion-{{ section.id }}::before {
      background-position: left -76px top -88px, right -78px top 34px, left -84px bottom -86px, right -86px bottom -88px;
      background-size: 120px 120px, 166px 166px, 195px 195px, 145px 145px;
    }
  }

  @media (hover: hover) {
    #ShopByOccasion-{{ section.id }} .shop-by-occasion__card:hover .shop-by-occasion__image {
      transform: scale(1.035);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ShopByOccasion-{{ section.id }} .shop-by-occasion__image {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Shop by occasion",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AVSAR ANUSAAR"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#801814"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Card label color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background motif opacity",
      "default": 35
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card spacing",
      "default": 6
    },
    {
      "type": "range",
      "id": "stagger_offset",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Second column offset",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 32
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "default": "daily wear"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image focal point",
          "options": [
            { "value": "center center", "label": "Center" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" },
            { "value": "left center", "label": "Left" },
            { "value": "right center", "label": "Right" }
          ],
          "default": "center center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by occasion",
      "blocks": [
        { "type": "occasion", "settings": { "title": "daily wear" } },
        { "type": "occasion", "settings": { "title": "festive" } },
        { "type": "occasion", "settings": { "title": "party wear" } },
        { "type": "occasion", "settings": { "title": "all time" } }
      ]
    }
  ]
}
{% endschema %}
