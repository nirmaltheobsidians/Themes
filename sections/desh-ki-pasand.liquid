{%- assign featured_collection = section.settings.collection -%}
{%- assign product_count = 0 -%}
{%- if featured_collection != blank -%}
  {%- assign product_count = featured_collection.products.size | at_most: section.settings.product_limit -%}
  {%- assign view_all_url = section.settings.view_all_link | default: featured_collection.url -%}
{%- endif -%}

<section
  id="DeshKiPasand-{{ section.id }}"
  class="desh-ki-pasand"
  style="
    --desh-ki-pasand-background: {{ section.settings.background_color }};
    --desh-ki-pasand-heading: {{ section.settings.heading_color }};
    --desh-ki-pasand-top: {{ section.settings.padding_top }}px;
    --desh-ki-pasand-bottom: {{ section.settings.padding_bottom }}px;
    --desh-ki-pasand-pattern-opacity: {{ section.settings.pattern_opacity | divided_by: 100.0 }};
  "
>
  <div class="desh-ki-pasand__inner page-width">
    {%- if section.settings.heading != blank -%}
      <header class="desh-ki-pasand__header">
        <img
          class="desh-ki-pasand__divider"
          src="{{ 'category-divider.svg' | asset_url }}"
          width="90"
          height="23"
          alt=""
          aria-hidden="true"
          loading="lazy"
        >
        <h2 class="desh-ki-pasand__heading">{{ section.settings.heading | escape }}</h2>
        <img
          class="desh-ki-pasand__divider desh-ki-pasand__divider--flipped"
          src="{{ 'category-divider.svg' | asset_url }}"
          width="90"
          height="23"
          alt=""
          aria-hidden="true"
          loading="lazy"
        >
      </header>
    {%- endif -%}

    {%- if product_count > 0 -%}
      <div class="desh-ki-pasand__products" data-desh-products>
        <div class="desh-ki-pasand__track" data-desh-track>
          <div class="desh-ki-pasand__track-inner">
          {%- for product in featured_collection.products limit: section.settings.product_limit -%}
            <div class="desh-ki-pasand__slide" data-desh-slide>
              <div class="desh-ki-pasand__card{% if product.images.size > 1 %} desh-ki-pasand__card--has-secondary{% endif %}">
                <div class="desh-ki-pasand__media">
                  <a
                    class="desh-ki-pasand__image-link"
                    href="{{ product.url }}"
                    aria-label="{{ product.title | escape }}"
                  >
                    {%- if product.featured_image != blank -%}
                      {{
                        product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'desh-ki-pasand__primary-image',
                          widths: '320, 480, 640, 900',
                          sizes: '(min-width: 990px) 25vw, 62vw',
                          loading: 'lazy',
                          alt: product.featured_image.alt | default: product.title
                      }}
                    {%- else -%}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'desh-ki-pasand__primary-image' }}
                    {%- endif -%}
                    {%- if product.images.size > 1 -%}
                      {{
                        product.images[1]
                        | image_url: width: 900
                        | image_tag:
                          class: 'desh-ki-pasand__secondary-image',
                          widths: '320, 480, 640, 900',
                          sizes: '(min-width: 990px) 25vw, 62vw',
                          loading: 'lazy',
                          alt: product.images[1].alt | default: product.title
                      }}
                    {%- endif -%}
                  </a>
                  <button
                    class="desh-ki-pasand__wishlist"
                    type="button"
                    data-td-wishlist-toggle
                    data-product-id="{{ product.id }}"
                    data-product-handle="{{ product.handle }}"
                    data-product-title="{{ product.title | escape }}"
                    data-product-vendor="{{ product.vendor | escape }}"
                    data-product-price="{{ product.price | money_without_currency | escape }}"
                    data-product-compare-price="{{ product.compare_at_price | money_without_currency | escape }}"
                    data-product-image="{{ product.featured_image | image_url: width: 600 }}"
                    data-product-url="{{ product.url }}"
                    data-product-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    data-product-default-variant="{{ product.selected_or_first_available_variant.title | escape }}"
                    aria-label="Add to wishlist"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M20.8 4.9a5.4 5.4 0 0 0-7.6 0L12 6.1l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6l1.2 1.2L12 21l7.6-7.3 1.2-1.2a5.4 5.4 0 0 0 0-7.6Z" />
                    </svg>
                  </button>
                </div>
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'portrait',
                  image_shape: false,
                  lazy_load: true,
                  show_secondary_image: false,
                  show_vendor: false,
                  show_rating: false,
                  skip_styles: false,
                  section_id: section.id,
                  quick_add: 'none',
                  product_view_context: 'collection'
                %}
                <div class="desh-ki-pasand__rating" role="img" aria-label="Rated 5 out of 5 stars, 52 reviews">
                  <span class="desh-ki-pasand__rating-stars" aria-hidden="true">★★★★★</span>
                  <span class="desh-ki-pasand__rating-count" aria-hidden="true">(52)</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
          </div>
        </div>

        {%- if product_count > 1 -%}
          <nav class="desh-ki-pasand__pagination" aria-label="Product slides">
            <div class="desh-ki-pasand__dots">
              {%- for product in featured_collection.products limit: section.settings.product_limit -%}
                <button
                  class="desh-ki-pasand__dot{% if forloop.first %} is-active{% endif %}"
                  type="button"
                  data-desh-dot="{{ forloop.index0 }}"
                  aria-label="Go to product {{ forloop.index }}"
                  {% if forloop.first %}aria-current="true"{% endif %}
                ></button>
              {%- endfor -%}
            </div>
          </nav>
        {%- endif -%}
        {%- if view_all_url != blank -%}
          <a class="desh-ki-pasand__view-all" href="{{ view_all_url }}">
            {{ section.settings.view_all_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="desh-ki-pasand__empty">
        Select a collection with products in the section settings to display product cards.
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #DeshKiPasand-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: var(--desh-ki-pasand-top);
    padding-bottom: var(--desh-ki-pasand-bottom);
    background-color: var(--desh-ki-pasand-background);
  }

  #DeshKiPasand-{{ section.id }}::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image:
      url('{{ 'category-mandala.svg' | asset_url }}'),
      url('{{ 'category-mandala.svg' | asset_url }}'),
      url('{{ 'category-mandala.svg' | asset_url }}')
      {%- if section.settings.show_bottom_right_motif -%},
        url('{{ 'category-mandala.svg' | asset_url }}')
      {%- endif -%};
    background-repeat: no-repeat;
    background-position: left -74px top -88px, right -82px top 28px, left -84px bottom -86px
      {%- if section.settings.show_bottom_right_motif -%}, right -82px bottom -88px{%- endif -%};
    background-size: 154px 154px, 196px 196px, 320px 320px
      {%- if section.settings.show_bottom_right_motif -%}, 178px 178px{%- endif -%};
    content: '';
    opacity: var(--desh-ki-pasand-pattern-opacity);
    pointer-events: none;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__inner {
    width: 100%;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto 24px;
    text-align: center;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__divider {
    display: block;
    width: 90px;
    height: 23px;
    object-fit: contain;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__divider--flipped {
    transform: rotate(180deg);
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__heading {
    margin: 4px 0;
    color: var(--desh-ki-pasand-heading);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(20px, 2.2vw, 32px);
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__track-inner {
    display: contents;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__slide,
  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__card,
  #DeshKiPasand-{{ section.id }} .card-wrapper,
  #DeshKiPasand-{{ section.id }} .card {
    min-width: 0;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__card {
    position: relative;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__media {
    position: relative;
    width: 100%;
    aspect-ratio: 0.7;
    overflow: hidden;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__image-link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__primary-image,
  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__secondary-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__secondary-image {
    z-index: 1;
    opacity: 0;
    transform: scale(1.025);
    transition:
      opacity 850ms cubic-bezier(0.2, 0.65, 0.3, 1),
      transform 1100ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    margin-top: 10px;
    color: #8d1915;
    line-height: 1;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__rating-stars {
    font-size: 19px;
    letter-spacing: -1px;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__rating-count {
    font-size: 11px;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__view-all {
    display: flex;
    width: 150px;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    margin: 24px auto 0;
    padding: 10px 18px;
    color: #fff;
    background: #801814;
    font-size: 12px;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 200ms ease;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__view-all:hover {
    background: #64110e;
  }

  #DeshKiPasand-{{ section.id }} .card-wrapper {
    position: relative;
  }

  #DeshKiPasand-{{ section.id }} .card,
  #DeshKiPasand-{{ section.id }} .card__inner {
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  #DeshKiPasand-{{ section.id }} .card__inner {
    display: none;
  }

  #DeshKiPasand-{{ section.id }} .td-trend-product-box-slider .swiper-pagination {
    display: none;
  }

  #DeshKiPasand-{{ section.id }} .card__content,
  #DeshKiPasand-{{ section.id }} .card__information,
  #DeshKiPasand-{{ section.id }} .card-information {
    padding: 0;
    text-align: center;
  }

  #DeshKiPasand-{{ section.id }} .card__content {
    padding-top: 12px;
  }

  #DeshKiPasand-{{ section.id }} .card__heading {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #DeshKiPasand-{{ section.id }} .card__heading a {
    text-decoration: none;
  }

  #DeshKiPasand-{{ section.id }} .price {
    justify-content: center;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 600;
  }

  #DeshKiPasand-{{ section.id }} .price__sale s {
    display: none;
  }

  #DeshKiPasand-{{ section.id }} .rating {
    vertical-align: middle;
  }

  #DeshKiPasand-{{ section.id }} .rating-star {
    --color-rating-star: #8d1915;
  }

  #DeshKiPasand-{{ section.id }} .rating-count {
    margin-left: 4px;
    color: #8d1915;
    font-size: 11px;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__wishlist {
    position: absolute;
    z-index: 2;
    right: 8px;
    top: 8px;
    display: grid;
    width: 36px;
    height: 36px;
    padding: 8px;
    place-items: center;
    color: #8d1915;
    background: #fff;
    border: 1px solid rgba(141, 25, 21, 0.12);
    border-radius: 50%;
    cursor: pointer;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__wishlist svg {
    width: 19px;
    height: 19px;
    fill: transparent;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__wishlist.TD_wishlist--active svg {
    fill: currentColor;
  }

  @media (hover: hover) {
    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__card:hover .desh-ki-pasand__primary-image,
    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__card:focus-within .desh-ki-pasand__primary-image {
      transform: scale(1.045);
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__card--has-secondary:hover .desh-ki-pasand__secondary-image,
    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__card--has-secondary:focus-within .desh-ki-pasand__secondary-image {
      opacity: 1;
      transform: scale(1);
    }
  }

  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__pagination,
  #DeshKiPasand-{{ section.id }} .desh-ki-pasand__empty {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #DeshKiPasand-{{ section.id }} {
      padding-right: 0;
      padding-left: 0;
    }

    #DeshKiPasand-{{ section.id }}::before {
      background-position: left -74px top -88px, right -82px top 28px, left -84px bottom -86px
        {%- if section.settings.show_bottom_right_motif -%}, right -82px bottom -88px{%- endif -%};
      background-size: 135px 135px, 176px 176px, 300px 300px
        {%- if section.settings.show_bottom_right_motif -%}, 158px 158px{%- endif -%};
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__header {
      margin-bottom: 20px;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__track {
      display: block;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__track::-webkit-scrollbar {
      display: none;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__track-inner {
      display: flex;
      align-items: stretch;
      gap: 22px;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__slide {
      flex: 0 0 62%;
      width: 62%;
      scroll-snap-align: center;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 24px;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__dot {
      position: relative;
      display: block;
      width: 8px;
      height: 8px;
      padding: 0;
      background: #101010;
      border: 0;
      border-radius: 50%;
      cursor: pointer;
      opacity: 0.38;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__dot.is-active {
      width: 18px;
      height: 18px;
      background: transparent;
      opacity: 1;
      transform: none;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__dot.is-active::before {
      position: absolute;
      inset: 0;
      background: url('{{ 'product-slider-dots.svg' | asset_url }}') center / contain no-repeat;
      content: '';
    }

  }

  @media screen and (min-width: 750px) {
    #DeshKiPasand-{{ section.id }} {
      padding-right: 0;
      padding-left: 0;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__header {
      margin-bottom: 32px;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__track {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__track-inner {
      display: contents;
    }

    #DeshKiPasand-{{ section.id }} .desh-ki-pasand__slide {
      flex: 0 0 auto;
      width: auto;
      margin-right: 0 !important;
    }
  }

{% endstyle %}

<script>
  (() => {
    const selector = '#DeshKiPasand-{{ section.id }}';

    const initializeRoot = (root) => {
      if (!root || root.dataset.deshInitialized === 'true') return;

      const track = root.querySelector('[data-desh-track]');
      const slides = Array.from(root.querySelectorAll('[data-desh-slide]'));
      const dots = Array.from(root.querySelectorAll('[data-desh-dot]'));
      if (!track || !slides.length) return;

      const initializeWishlist = () => {
        if (window.TD_Wishlist || root.dataset.deshWishlistInitialized === 'true') return;

        const wishlistButtons = Array.from(root.querySelectorAll('[data-td-wishlist-toggle]'));
        const readWishlist = () => {
          try {
            const storedWishlist = window.localStorage.getItem('TD_wishlist_v1');
            const wishlist = storedWishlist ? JSON.parse(storedWishlist) : [];
            if (!Array.isArray(wishlist)) throw new Error('Stored wishlist must be an array.');
            return wishlist;
          } catch (error) {
            console.error('[Desh ki pasand] Wishlist could not be read.', error);
            return null;
          }
        };

        const updateWishlistButtons = (wishlist) => {
          wishlistButtons.forEach((button) => {
            const isActive = wishlist.some((item) => String(item.id) === button.dataset.productId);
            button.classList.toggle('TD_wishlist--active', isActive);
            button.setAttribute('aria-label', isActive ? 'Remove from wishlist' : 'Add to wishlist');
            button.setAttribute('aria-pressed', String(isActive));
          });
        };

        const initialWishlist = readWishlist();
        if (initialWishlist) updateWishlistButtons(initialWishlist);

        wishlistButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const wishlist = readWishlist();
            if (!wishlist) return;

            const productId = button.dataset.productId;
            const existingIndex = wishlist.findIndex((item) => String(item.id) === productId);
            if (existingIndex >= 0) {
              wishlist.splice(existingIndex, 1);
            } else {
              wishlist.push({
                id: productId,
                handle: button.dataset.productHandle,
                title: button.dataset.productTitle,
                vendor: button.dataset.productVendor,
                price: button.dataset.productPrice,
                comparePrice: button.dataset.productComparePrice,
                image: button.dataset.productImage,
                url: button.dataset.productUrl,
                variantId: button.dataset.productVariantId,
                defaultVariant: button.dataset.productDefaultVariant,
              });
            }

            try {
              window.localStorage.setItem('TD_wishlist_v1', JSON.stringify(wishlist));
            } catch (error) {
              console.error('[Desh ki pasand] Wishlist could not be saved.', error);
              return;
            }

            updateWishlistButtons(wishlist);
            document.querySelectorAll('[data-td-wishlist-count]').forEach((badge) => {
              badge.textContent = String(wishlist.length);
              badge.hidden = wishlist.length === 0;
            });
          });
        });

        root.dataset.deshWishlistInitialized = 'true';
      };

      initializeWishlist();

      const updateActiveDot = () => {
        if (!dots.length || window.matchMedia('(min-width: 750px)').matches) return;

        const trackCenter = track.getBoundingClientRect().left + track.clientWidth / 2;
        let closestIndex = 0;
        let closestDistance = Infinity;

        slides.forEach((slide, index) => {
          const slideCenter = slide.getBoundingClientRect().left + slide.clientWidth / 2;
          const distance = Math.abs(trackCenter - slideCenter);
          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        dots.forEach((dot, index) => {
          const isActive = index === closestIndex;
          dot.classList.toggle('is-active', isActive);
          if (isActive) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      };

      let scrollFrame = 0;
      const onTrackScroll = () => {
        if (scrollFrame) cancelAnimationFrame(scrollFrame);
        scrollFrame = requestAnimationFrame(() => {
          scrollFrame = 0;
          updateActiveDot();
        });
      };

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const targetSlide = slides[Number(dot.dataset.deshDot)];
          if (!targetSlide || window.matchMedia('(min-width: 750px)').matches) return;

          const trackRect = track.getBoundingClientRect();
          const slideRect = targetSlide.getBoundingClientRect();
          const targetLeft = track.scrollLeft
            + slideRect.left
            - trackRect.left
            - (track.clientWidth - slideRect.width) / 2;
          track.scrollTo({ left: targetLeft, behavior: 'smooth' });
        });
      });

      track.addEventListener('scroll', onTrackScroll, { passive: true });
      window.addEventListener('resize', updateActiveDot);
      updateActiveDot();
      root.dataset.deshInitialized = 'true';
      root.deshCleanup = () => {
        track.removeEventListener('scroll', onTrackScroll);
        window.removeEventListener('resize', updateActiveDot);
        if (scrollFrame) cancelAnimationFrame(scrollFrame);
      };
    };

    const initialize = (scope = document) => {
      if (scope.matches?.(selector)) {
        initializeRoot(scope);
      } else {
        scope.querySelectorAll?.(selector).forEach(initializeRoot);
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initialize(), { once: true });
    } else {
      initialize();
    }

    document.addEventListener('shopify:section:load', (event) => initialize(event.target));
    document.addEventListener('shopify:section:unload', (event) => {
      const root = event.target.matches?.(selector)
        ? event.target
        : event.target.querySelector?.(selector);
      if (root?.deshCleanup) root.deshCleanup();
    });
  })();
