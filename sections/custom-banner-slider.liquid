{%- liquid
  assign slide_count = section.blocks.size
-%}

{%- if slide_count > 0 -%}
  <section
    class="custom-banner-slider-section"
    style="
      --custom-banner-height: {{ section.settings.banner_height }}px;
      --custom-banner-mobile-height: {{ section.settings.mobile_banner_height }}px;
      --custom-banner-radius: {{ section.settings.corner_radius }}px;
      --custom-banner-space-top: {{ section.settings.space_top }}px;
      --custom-banner-space-bottom: {{ section.settings.space_bottom }}px;
      --custom-banner-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      --custom-banner-arrow-background: {{ section.settings.arrow_background }};
      --custom-banner-arrow-color: {{ section.settings.arrow_color }};
      --custom-banner-dot-color: {{ section.settings.dot_color }};
    "
    aria-label="{{ section.settings.accessibility_label | escape }}"
  >
    <div
      class="custom-banner-slider swiper"
      data-custom-banner-slider
      data-autoplay="{{ section.settings.auto_rotate }}"
      data-speed="{{ section.settings.change_slides_speed }}"
      data-transition="{{ section.settings.transition_speed }}"
      data-loop="{{ section.settings.loop_slides }}"
    >
      <div class="custom-banner-slider__track swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- liquid
            assign desktop_image = block.settings.image
            assign mobile_image = block.settings.mobile_image | default: desktop_image
            assign image_alt = block.settings.image.alt | default: block.settings.heading | default: shop.name | escape
            assign image_loading = 'lazy'
            assign image_fetch_priority = 'auto'
            if forloop.first
              assign image_loading = 'eager'
              assign image_fetch_priority = 'high'
            endif
          -%}
          <div
            class="custom-banner-slider__slide swiper-slide"
            style="--custom-banner-image-position: {{ block.settings.image_position }};"
            role="group"
            aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
            aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a class="custom-banner-slider__image-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.link_label | default: image_alt | escape }}">
            {%- else -%}
              <div class="custom-banner-slider__image-link">
            {%- endif -%}
              {%- if desktop_image != blank -%}
                <picture class="custom-banner-slider__picture">
                  {%- if mobile_image != blank -%}
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {{ mobile_image | image_url: width: 480 }} 480w,
                        {{ mobile_image | image_url: width: 750 }} 750w,
                        {{ mobile_image | image_url: width: 990 }} 990w
                      "
                      sizes="100vw"
                    >
                  {%- endif -%}
                  {{
                    desktop_image
                    | image_url: width: 2400
                    | image_tag:
                      class: 'custom-banner-slider__image',
                      widths: '750, 990, 1200, 1500, 1800, 2200, 2400',
                      sizes: '100vw',
                      loading: image_loading,
                      fetchpriority: image_fetch_priority,
                      alt: image_alt
                  }}
                </picture>
              {%- else -%}
                <div class="custom-banner-slider__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-banner-slider__placeholder-image' }}
                  <span>Select a banner image in this slide's settings</span>
                </div>
              {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank or block.settings.button_label != blank -%}
              <div class="custom-banner-slider__content custom-banner-slider__content--{{ block.settings.content_position }} custom-banner-slider__content--{{ block.settings.text_alignment }}">
                {%- if block.settings.heading != blank -%}
                  <h2 class="custom-banner-slider__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                  <a class="custom-banner-slider__button" href="{{ block.settings.button_link }}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if slide_count > 1 and section.settings.show_arrows -%}
        <button
          class="custom-banner-slider__arrow custom-banner-slider__arrow--previous"
          type="button"
          data-banner-previous
          aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m15 18-6-6 6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
          </svg>
        </button>
        <button
          class="custom-banner-slider__arrow custom-banner-slider__arrow--next"
          type="button"
          data-banner-next
          aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
          </svg>
        </button>
      {%- endif -%}

      {%- if slide_count > 1 and section.settings.show_dots -%}
        <div class="custom-banner-slider__pagination" data-banner-pagination aria-label="{{ 'sections.slideshow.carousel' | t }}"></div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Custom banner slider",
  "tag": "section",
  "class": "custom-banner-slider-shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Featured banners"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Desktop banner height",
      "default": 700
    },
    {
      "type": "range",
      "id": "mobile_banner_height",
      "min": 240,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Mobile banner height",
      "default": 480
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 14
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space above",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space below",
      "default": 24
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Automatically change slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slide every",
      "default": 5
    },
    {
      "type": "range",
      "id": "transition_speed",
      "min": 300,
      "max": 1200,
      "step": 100,
      "unit": "ms",
      "label": "Slide transition speed",
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "loop_slides",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "color",
      "id": "arrow_background",
      "label": "Arrow background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#26383a"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Pagination color",
      "default": "#ffffff"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "slide",
      "name": "Banner slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. The desktop image is used if this is left blank."
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image focal point",
          "options": [
            { "value": "center center", "label": "Center" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" },
            { "value": "left center", "label": "Left" },
            { "value": "right center", "label": "Right" }
          ],
          "default": "center center"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link entire banner"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Banner link accessibility label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Optional heading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Optional button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Optional button link"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Text position",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "top", "label": "Top" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom banner slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
