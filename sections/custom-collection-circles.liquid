{%- liquid
  assign visible_blocks = 0
  for block in section.blocks
    assign item_collection = block.settings.collection
    assign item_image = block.settings.image
    if item_image == blank and item_collection != blank
      assign item_image = item_collection.image | default: item_collection.products.first.featured_image
    endif
    if item_image != blank or block.settings.title != blank or item_collection != blank
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor
-%}

{%- if visible_blocks > 0 -%}
  <section
    class="custom-collection-circles"
    style="
      --collection-circles-background: {{ section.settings.background_color }};
      --collection-circles-text: {{ section.settings.text_color }};
      --collection-circles-border: {{ section.settings.ring_color }};
      --collection-circles-border-width: {{ section.settings.ring_width }}px;
      --collection-circles-size: {{ section.settings.image_size }}px;
      --collection-circles-mobile-size: {{ section.settings.mobile_image_size }}px;
      --collection-circles-gap: {{ section.settings.item_gap }}px;
      --collection-circles-space-top: {{ section.settings.space_top }}px;
      --collection-circles-space-bottom: {{ section.settings.space_bottom }}px;
    "
    data-custom-collection-circles
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="custom-collection-circles__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div
      class="custom-collection-circles__slider swiper"
      data-collection-circles-slider
      data-gap="{{ section.settings.item_gap }}"
      data-autoplay="{{ section.settings.auto_rotate }}"
      data-speed="{{ section.settings.change_slides_speed }}"
    >
      <div class="custom-collection-circles__track swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_collection = block.settings.collection
            assign item_image = block.settings.image
            if item_image == blank and item_collection != blank
              assign item_image = item_collection.image | default: item_collection.products.first.featured_image
            endif
            assign item_title = block.settings.title | default: item_collection.title
            assign item_url = block.settings.link | default: item_collection.url
            if item_title == blank
              assign item_title = 'Collection'
            endif
            assign image_alt = block.settings.image.alt | default: item_title | escape
          -%}
          {%- if item_image != blank or item_collection != blank or block.settings.title != blank -%}
            <div
              class="custom-collection-circles__slide swiper-slide"
              style="--collection-circle-index: {{ forloop.index0 }}; --collection-circle-image-position: {{ block.settings.image_position }};"
              {{ block.shopify_attributes }}
            >
              {%- if item_url != blank -%}
                <a class="custom-collection-circles__link" href="{{ item_url }}">
              {%- else -%}
                <div class="custom-collection-circles__link">
              {%- endif -%}
                <span class="custom-collection-circles__ring">
                  <span class="custom-collection-circles__image-frame">
                    {%- if item_image != blank -%}
                      {{
                        item_image
                        | image_url: width: 480
                        | image_tag:
                          class: 'custom-collection-circles__image',
                          widths: '120, 180, 240, 320, 400, 480',
                          sizes: '(max-width: 749px) 120px, 170px',
                          loading: 'lazy',
                          alt: image_alt
                      }}
                    {%- else -%}
                      {{ 'collection-apparel-1' | placeholder_svg_tag: 'custom-collection-circles__placeholder' }}
                    {%- endif -%}
                  </span>
                </span>
                <span class="custom-collection-circles__title">{{ item_title | escape }}</span>
              {%- if item_url != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_arrows and visible_blocks > 1 -%}
        <button
          class="custom-collection-circles__arrow custom-collection-circles__arrow--previous"
          type="button"
          data-collection-previous
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m15 18-6-6 6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
          </svg>
        </button>
        <button
          class="custom-collection-circles__arrow custom-collection-circles__arrow--next"
          type="button"
          data-collection-next
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
          </svg>
        </button>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection circles",
  "tag": "section",
  "class": "custom-collection-circles-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#fff8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Collection label color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "ring_color",
      "label": "Image ring color",
      "default": "#a10f19"
    },
    {
      "type": "range",
      "id": "ring_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Image ring width",
      "default": 2
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 100,
      "max": 210,
      "step": 5,
      "unit": "px",
      "label": "Desktop image size",
      "default": 170
    },
    {
      "type": "range",
      "id": "mobile_image_size",
      "min": 80,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Mobile image size",
      "default": 120
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space between collections",
      "default": 20
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space above section",
      "default": 12
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space below section",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show slider arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Automatically scroll collections",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 5
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image",
          "info": "Optional. Uses the collection image if left blank."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override label",
          "info": "Optional. Uses the collection title if left blank."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Override link"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image focal point",
          "options": [
            { "value": "center center", "label": "Center" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" },
            { "value": "left center", "label": "Left" },
            { "value": "right center", "label": "Right" }
          ],
          "default": "center center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection circles",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
